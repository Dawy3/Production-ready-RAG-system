# RabbitMQ configuration Example
RABBITMQ_DEFAULT_USER=rag_user
RABBITMQ_DEFAULT_PASS=rag_rabbitmq_2222
RABBITMQ_DEFAULT_VHOST=rag_vhost

# Management Plugin 
RABBITMQ_MANAGEMENT_ENABLE=true


# Security
RABBITMQ_AUTH_BACKEND=rabbit_auth_backend_internal

# Performance
RABBITMQ_DISK_FREE_LIMIT=2000000000